rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      // Allow users to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow users to create their own document (for TOS acceptance on first login)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow users to update their own document (for TOS acceptance, FCM tokens, etc.)
      allow update: if request.auth != null && request.auth.uid == userId;

      // Allow users to delete their own document
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Allow admins to read all user documents
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';

      // Allow admins to update any user document
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
    }

    // QR tokens collection - only Functions can write, authenticated users can read
    match /qr_tokens/{tokenId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Functions can write via Admin SDK
    }

    // Logs collection - only Functions can write, authenticated users can read, admin can delete
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create, update: if false; // Only Functions can create/update via Admin SDK
      // Allow admin to delete logs for cleanup purposes
      allow delete: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
    }

    // GroupMe tokens collection - users can only access their own tokens
    match /groupme_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // GroupMe bots collection - users can only access their own bots
    match /groupme_bots/{botId} {
      allow read, write: if request.auth != null && 
        resource.data.firebase_uid == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.firebase_uid == request.auth.uid;
    }

    // Workvivo config collection - users can only access their own config
    match /workvivo_config/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Support tickets collection - users can create tickets, only admin can read/update all
    match /support_tickets/{ticketId} {
      // Users can create their own tickets
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Users can read their own tickets
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com'));
      
      // Only admin can update tickets (for responses)
      allow update: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
      
      // Admin can read all tickets (for list queries)
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
    }

    // Blocked IPs collection - only Functions/Admin can write, admin can read
    match /blocked_ips/{ipAddress} {
      // Only admin can read blocked IPs
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
      // Only Functions can write via Admin SDK
      allow write: if false;
    }

    // Spam logs collection - only Functions can write, admin can read
    match /spam_logs/{logId} {
      // Only admin can read spam logs
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
      // Only Functions can write via Admin SDK
      allow write: if false;
    }

    // Directory collection - authenticated users can read to verify access
    match /directory/{personId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin via functions
    }

    // Tasks collection - for APTasks calendar
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';

      // Task links subcollection
      match /links/{linkId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com';
      }

      // Audit log - append-only
      match /audit/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Scans collection - users can read scans for their store and claim assistance
    match /scans/{scanId} {
      // Helper function to get user store number as string
      function getUserStore() {
        let userStore = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeNumber;
        return userStore is string ? userStore : string(userStore);
      }
      
      // Helper function to get scan store number as string
      function getScanStore() {
        let scanStore = resource.data.storeNumber;
        return scanStore is string ? scanStore : string(scanStore);
      }
      
      // Users can read scans for their own store number
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getScanStore() == getUserStore() || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'sinaptick@gmail.com');
      
      // Users can update scans to claim assistance (set claimedBy, claimedByName, claimedAt)
      allow update: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getScanStore() == getUserStore() &&
        // Only allow updating claim-related and response fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedByName', 'claimedAt', 'status', 'responses']);
      
      // Only Functions can create scans via Admin SDK
      allow create: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}