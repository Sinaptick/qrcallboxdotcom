<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:layout_marginBottom="8dp"
    android:padding="16dp"
    android:elevation="2dp">

    <!-- User Name and Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Associate Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvOnlineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 On Shift"
            android:textSize="12sp"
            android:textColor="@color/teal_700"
            android:background="@drawable/status_badge_background"
            android:padding="4dp" />

    </LinearLayout>

    <!-- User Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Store: "
            android:textSize="14sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvStoreNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1458"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • Last Active: "
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginLeft="16dp" />

        <TextView
            android:id="@+id/tvLastActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 hours ago"
            android:textSize="14sp"
            android:textColor="@color/black" />

    </LinearLayout>

    <!-- Work Schedule -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Shift: "
            android:textSize="14sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvShiftTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:00 AM - 5:00 PM"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>